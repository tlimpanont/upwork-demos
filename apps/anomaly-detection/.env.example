# MongoDB Atlas connection string. Atlas Vector Search requires a cluster
# (free-tier M0 works for the demo).
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=anomaly_detection

# OpenAI for image captioning + embeddings (also the fallback vision judge
# when Grounding DINO isn't configured).
OPENAI_API_KEY=sk-...

# Replicate API token for Grounding DINO — the open-vocabulary object
# detector that powers description-driven detection. When set, the detect
# pipeline uses Grounding DINO for pixel-precise bboxes and falls back to
# gpt-4o-mini only if the call fails. Without this token detection still
# works via the OpenAI vision path, just less precise.
REPLICATE_API_TOKEN=

# Optional: pin a specific Grounding DINO model + version hash.
# Defaults to `adirik/grounding-dino` (latest).
REPLICATE_GROUNDING_DINO_MODEL=

# Vercel Blob for private image storage.
BLOB_READ_WRITE_TOKEN=vercel_blob_...

# Auth.js v5
AUTH_SECRET=                                  # openssl rand -base64 32
AUTH_URL=http://localhost:3007

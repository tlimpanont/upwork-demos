{
  "name": "saas-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Production-ready multi-tenant SaaS starter \u2014 auth, organizations, role-based access, Stripe billing, and an admin dashboard. Built with Next.js, MUI, NextAuth, Neon Postgres, and Stripe.",
  "license": "MIT",
  "author": {
    "name": "Theuy Limpanont"
  },
  "keywords": [
    "saas",
    "saas-starter",
    "multi-tenant",
    "nextjs",
    "next-auth",
    "auth-js",
    "stripe",
    "stripe-checkout",
    "mui",
    "material-ui",
    "postgres",
    "neon",
    "typescript",
    "vercel"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "next start -p 3003",
    "lint": "eslint",
    "clean": "rm -rf .next .turbo",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "stripe-listen": "stripe listen --forward-to localhost:3003/api/webhooks/stripe"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@mui/material-nextjs": "^9.0.0",
    "bcryptjs": "^3.0.3",
    "next": "16.2.4",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.1.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "typescript": "^5"
  }
}

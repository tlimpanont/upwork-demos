# Contact form via Resend.
# Get an API key at https://resend.com — free tier covers low volume.
RESEND_API_KEY=re_...

# Inbox the contact form delivers to. Keep this out of source control —
# it's the address spam bots would otherwise harvest from the repo.
RESEND_TO_EMAIL=you@example.com

# Optional. Defaults to "onboarding@resend.dev" which works without
# domain verification, but mail clients may flag it as spam. Once you
# verify a domain in Resend, set this to e.g. "contact@yourdomain.com".
# RESEND_FROM_EMAIL=contact@yourdomain.com

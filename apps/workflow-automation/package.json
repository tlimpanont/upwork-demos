{
  "name": "upwork-demo-workflow-automation",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered workflow automation demo: OpenAI classifies, deterministic rules route, dashboard shows the full pipeline.",
  "license": "MIT",
  "author": {
    "name": "Theuy Limpanont"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build",
    "start": "next start -p 3005",
    "lint": "eslint",
    "clean": "rm -rf .next .turbo",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:seed": "dotenv -e .env.local -- tsx scripts/seed.ts",
    "db:reset": "dotenv -e .env.local -- prisma db push --force-reset && npm run db:seed",
    "smoke": "dotenv -e .env.local -- tsx scripts/classify-smoke.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@faker-js/faker": "^10.0.0",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@mui/material-nextjs": "^9.0.0",
    "@prisma/client": "^6.18.0",
    "next": "16.2.4",
    "openai": "^6.35.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^6.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5"
  }
}

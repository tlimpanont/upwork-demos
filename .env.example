# Shared env values for all apps.
# Each app inherits from the root .env (loaded by Next via dotenv) and may override
# in apps/<app>/.env.local. Real values go in `.env` (gitignored), not here.

# OpenAI
OPENAI_API_KEY=sk-...

# Neon Postgres (or any Postgres connection string)
DATABASE_URL=postgres://...

# Dedicated Postgres for analytics-dashboard (separate Neon project/branch).
ANALYTICS_DATABASE_URL=postgres://...

# Dedicated Postgres for workflow-automation (separate Neon project/branch).
WORKFLOW_DATABASE_URL=postgres://...

# Pinecone (serverless index, 1536 dims, cosine)
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=your-index-name

# Vercel Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_...

# NextAuth (saas-starter only)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3003

# Stripe (saas-starter only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
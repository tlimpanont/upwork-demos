{
  "name": "upwork-demo-anomaly-detection",
  "version": "0.1.0",
  "private": true,
  "description": "AI time-series image anomaly detection: upload chronological image sequences, annotate normal/anomalous regions, train an embedding-based detector on MongoDB Atlas Vector Search, and surface detections with heatmaps and bounding boxes.",
  "license": "MIT",
  "author": {
    "name": "Theuy Limpanont"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3007",
    "build": "next build",
    "start": "next start -p 3007",
    "lint": "eslint",
    "clean": "rm -rf .next .turbo",
    "db:vector-index": "dotenv -e .env.local -- tsx scripts/create-vector-index.ts",
    "db:seed": "dotenv -e .env.local -- tsx scripts/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.3.3",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "konva": "^9.3.18",
    "lucide-react": "^0.460.0",
    "mongodb": "^6.10.0",
    "next": "16.2.4",
    "next-auth": "^5.0.0-beta.31",
    "openai": "^6.35.0",
    "pdfkit": "^0.15.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.54.2",
    "react-konva": "^19.2.4",
    "recharts": "^2.15.0",
    "replicate": "^1.4.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^2.5.5",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pdfkit": "^0.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5"
  }
}

{
  "name": "ai-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Upload PDF invoices and business documents \u2014 AI extracts structured data (vendor, amounts, tax, line items) and indexes them for hybrid semantic + exact-numeric search.",
  "keywords": [
    "nextjs",
    "ai",
    "openai",
    "gpt-4o-mini",
    "vercel-ai-sdk",
    "document-processing",
    "invoice-extraction",
    "pdf",
    "ocr",
    "rag",
    "semantic-search",
    "vector-search",
    "pinecone",
    "neon",
    "postgres",
    "vercel-blob",
    "typescript",
    "tailwindcss"
  ],
  "author": "Theuy Limpanont",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --turbopack -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "lint": "next lint",
    "clean": "rm -rf .next .turbo",
    "db:init": "curl -s -X POST http://localhost:3002/api/init-db | npx --yes prettier --parser json"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.58",
    "@neondatabase/serverless": "^1.1.0",
    "@pinecone-database/pinecone": "^7.2.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.3.3",
    "ai": "^6.0.174",
    "fflate": "^0.8.2",
    "next": "16.2.4",
    "openai": "^6.35.0",
    "pdfkit": "^0.18.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "unpdf": "^1.6.2",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  }
}

{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env", ".env.local"],
  "globalEnv": [
    "NODE_ENV",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "OPENAI_API_KEY",
        "DATABASE_URL",
        "ANALYTICS_DATABASE_URL",
        "WORKFLOW_DATABASE_URL",
        "SLACK_WEBHOOK_URL",
        "PINECONE_API_KEY",
        "PINECONE_INDEX_NAME",
        "BLOB_READ_WRITE_TOKEN",
        "AUTH_SECRET",
        "AUTH_URL",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "NEXT_PUBLIC_STRIPE_PRICE_PRO",
        "MONGODB_URI",
        "MONGODB_DB",
        "REPLICATE_API_TOKEN",
        "REPLICATE_GROUNDING_DINO_MODEL",
        "DEMO_USER_EMAIL",
        "DEMO_USER_PASSWORD",
        "CRON_SECRET",
        "RESEND_API_KEY",
        "RESEND_TO_EMAIL",
        "RESEND_FROM_EMAIL",
        "NEXT_PUBLIC_LINKEDIN_PARTNER_ID"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "OPENAI_API_KEY",
        "DATABASE_URL",
        "ANALYTICS_DATABASE_URL",
        "WORKFLOW_DATABASE_URL",
        "SLACK_WEBHOOK_URL",
        "PINECONE_API_KEY",
        "PINECONE_INDEX_NAME",
        "BLOB_READ_WRITE_TOKEN",
        "AUTH_SECRET",
        "AUTH_URL",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "NEXT_PUBLIC_STRIPE_PRICE_PRO",
        "MONGODB_URI",
        "MONGODB_DB",
        "REPLICATE_API_TOKEN",
        "REPLICATE_GROUNDING_DINO_MODEL",
        "DEMO_USER_EMAIL",
        "DEMO_USER_PASSWORD",
        "CRON_SECRET",
        "RESEND_API_KEY",
        "RESEND_TO_EMAIL",
        "RESEND_FROM_EMAIL",
        "NEXT_PUBLIC_LINKEDIN_PARTNER_ID"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"]
    },
    "clean": {
      "cache": false
    }
  }
}

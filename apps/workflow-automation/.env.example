# Dedicated Postgres for the workflow-automation demo. Use a separate Neon
# project or branch so seeding cannot touch tables owned by the other apps.
WORKFLOW_DATABASE_URL="postgresql://user:password@host:5432/workflow?sslmode=require"
OPENAI_API_KEY=

# Optional: Slack incoming webhook. When set, the pipeline posts a Block Kit
# message for fraud and escalation routes. Without it those rows are marked
# "slack_skipped" in the action log — the rest of the pipeline is unaffected.
SLACK_WEBHOOK_URL=

{
  "name": "ai-chatbot",
  "version": "0.1.0",
  "private": true,
  "description": "RAG-powered AI customer support chatbot built with Next.js, OpenAI, Pinecone, and Neon. Upload documents to a knowledge base and let the AI answer customer questions grounded in your content.",
  "keywords": ["ai", "rag", "customer-support", "nextjs", "openai", "pinecone", "chatbot"],
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "clean": "rm -rf .next .turbo",
    "db:setup": "tsx scripts/setup-db.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.58",
    "@ai-sdk/react": "^3.0.176",
    "@assistant-ui/react": "^0.12.28",
    "@assistant-ui/react-ai-sdk": "^1.3.21",
    "@neondatabase/serverless": "^1.1.0",
    "@pinecone-database/pinecone": "^7.2.0",
    "ai": "^6.0.174",
    "next": "16.2.4",
    "openai": "^6.35.0",
    "pdf-parse": "^2.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
